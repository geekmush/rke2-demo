# Non-secret defaults for the do-test environment.
#
# Copy this file to terraform.tfvars (which is gitignored) and edit the
# ssh_pubkey value to match your operator key. All other values have
# sensible defaults in variables.tf — override only what you need.
#
# Secrets (the DO API token) live in secrets.enc.tfvars, encrypted with SOPS.
# Do NOT put do_token here.

# Required — paste your OpenSSH public key. Generate one if you do not have one
# dedicated to this project:
#   ssh-keygen -t ed25519 -C "rke2-demo operator" -f ~/.ssh/rke2_demo_ed25519
#   cat ~/.ssh/rke2_demo_ed25519.pub
ssh_pubkey = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... operator@workstation"

# Optional overrides (defaults shown):
# project_name    = "rke2-demo"        # resource-name prefix in DO
# region          = "nyc3"
# vpc_cidr        = "10.42.0.0/20"
# cp_count        = 3
# cp_size         = "s-2vcpu-4gb"
# worker_count    = 3
# worker_size     = "s-4vcpu-8gb"
# image_slug      = "ubuntu-24-04-x64"
# tags            = []
# do_project_name = "RKE2"             # existing DO Project (set to null to skip)

# Narrow public SSH exposure to specific CIDRs if you want (key-only is
# enforced in sshd regardless). Default is world-reachable per the access model.
# allowed_ssh_cidrs = ["198.51.100.7/32"]
