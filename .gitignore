# OS / editor
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Secrets / local state
*.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
known_hosts

# OpenTofu / Terraform
.terraform/
# .terraform.lock.hcl IS committed — pins provider hashes for reproducibility.
*.tfstate
# Saved plan files embed decrypted variable values (including SOPS-sourced
# secrets). Never commit them. Operators should delete them after apply.
tfplan*.bin
*.tfplan
*.tfstate.*
*.tfvars
!*.tfvars.example
!*.enc.tfvars
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# SOPS / secrets — only *.enc.* files are allowed in git
secrets/
secrets.yaml
secrets.yml
secrets.json
secrets.env
!*.enc.yaml
!*.enc.yml
!*.enc.json
!*.enc.env
# Local SOPS age key material (must never leave the operator workstation)
age.key
*.age
keys.txt

# Ansible
*.retry
ansible/.vault_pass
ansible/inventory/host_vars/*.local.yml
ansible/inventory/group_vars/*.local.yml

# Python / uv
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Kube
kubeconfig*
*.kubeconfig

# Node (for OpenSpec tooling)
node_modules/
npm-debug.log*

# Claude Code per-user state (memory under .claude/memory/ IS committed by policy)
.claude/settings.local.json
.claude/worktrees/
