# OS / editor
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Secrets / local state
*.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
known_hosts

# OpenTofu / Terraform
.terraform/
# .terraform.lock.hcl IS committed — pins provider hashes for reproducibility.
*.tfstate
# Saved plan files embed decrypted variable values (including SOPS-sourced
# secrets). Never commit them. Operators should delete them after apply.
tfplan*.bin
*.tfplan
*.tfstate.*
*.tfvars
!*.tfvars.example
!*.enc.tfvars
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# SOPS / secrets
# Two conventions live side by side here:
#   - Our own: *.enc.<ext> -- committed, SOPS-encrypted. tfvars, env, json, yaml.
#   - devopscoop/fluxcd-template: *.secrets.yaml + *.helm_secrets.yaml --
#     committed, SOPS-encrypted. Operator-edits-then-encrypts via *.decrypted.
# The `*.decrypted` files are operator-local plaintext scratch. They must
# be re-encrypted to their committed twin before commit.
*.decrypted
# Local SOPS age key material (must never leave the operator workstation)
age.key
*.age
keys.txt

# FluxCD tooling cache (deploy.sh fetches kubectl/sops/flux/yq into bin/)
bin/*

# Ansible
*.retry
ansible/.vault_pass
ansible/inventory/host_vars/*.local.yml
ansible/inventory/group_vars/*.local.yml

# Python / uv
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Kube
kubeconfig*
*.kubeconfig

# Node (for OpenSpec tooling)
node_modules/
npm-debug.log*

# Claude Code per-user state (memory under .claude/memory/ IS committed by policy)
.claude/settings.local.json
.claude/worktrees/
