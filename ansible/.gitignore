# Generated inventory — produced from `tofu output -json` by scripts/render-inventory.py.
inventory/generated.yaml

# Belt-and-braces: artifacts/ used to hold the operator kubeconfig before it
# was moved to ~/.kube/rke2-demo. Keep the rule so a future stray write
# inside the repo working tree still doesn't escape into git.
artifacts/

# Ansible Galaxy collection cache (if anyone uses --target ./.galaxy-cache).
.galaxy-cache/

# Ansible retry files (also disabled in ansible.cfg, but belt-and-braces).
*.retry
